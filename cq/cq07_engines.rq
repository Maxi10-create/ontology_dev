# KF7: Welche Engine unterstützt welchen Schritt, und welche Ein- und Ausgaben hat sie?
PREFIX mp:    <https://w3id.org/mapact/core#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX pplan: <http://purl.org/net/p-plan#>
SELECT DISTINCT ?engine ?schritt ?liest ?liefert ?modul WHERE {
  ?e a mp:Engine ; rdfs:label ?engine ; mp:supportsStep ?s ; mp:implementedIn ?modul .
  ?s rdfs:label ?schritt .
  OPTIONAL { ?e mp:engineInput ?i . ?i rdfs:label ?liest }
  OPTIONAL { ?e mp:engineOutput ?o . ?o rdfs:label ?liefert }
}
ORDER BY ?engine ?s
