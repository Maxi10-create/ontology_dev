# KF5: Welche Bedingungen müssen erfüllt sein, damit ein Schritt als abgeschlossen gilt?
PREFIX mp:    <https://w3id.org/mapact/core#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX pplan: <http://purl.org/net/p-plan#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?schritt ?bedingung ?definition WHERE {
  ?s mp:completionCondition ?c ; rdfs:label ?schritt .
  ?c rdfs:label ?bedingung ; skos:definition ?definition .
}
ORDER BY ?s
